. "$SNAP_COMMON/config/credentials.env"
OPENFGA_DATASTORE_ENGINE=postgres
OPENFGA_DATASTORE_URI="$OPENFGA_DSN"
OPENFGA_AUTHN_METHOD=preshared
OPENFGA_AUTHN_PRESHARED_KEYS="$OPENFGA_TOKEN"
OPENFGA_HTTP_ADDR=127.0.0.1:18580
OPENFGA_GRPC_ADDR=127.0.0.1:18581
OPENFGA_PLAYGROUND_ENABLED=false
OPENFGA_METRICS_ENABLED=false
OPENFGA_LOG_LEVEL=info
