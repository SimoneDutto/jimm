. "$SNAP_COMMON/config/credentials.env"
JIMM_UUID="$UUID"
JIMM_ADMINS=admin@microjaas.local
JIMM_DNS_NAME=https://microjaas.test:18443
JIMM_LISTEN_ADDR=microjaas.test:18443
JIMM_TLS_CERT="$SNAP_COMMON/config/tls.crt"
JIMM_TLS_KEY="$SNAP_COMMON/config/tls.key"
JIMM_INTERNAL_LISTEN_ADDR=127.0.0.1:18590
JIMM_IS_LEADER=true
INSECURE_SECRET_STORAGE=true
BAKERY_PRIVATE_KEY="$BAKERY_PRIVATE"
BAKERY_PUBLIC_KEY="$BAKERY_PUBLIC"
JIMM_JWKS_PATH="$SNAP_COMMON/config/jwks.json"
JIMM_JWKS_PRIVATE_KEY_PATH="$SNAP_COMMON/config/signing.pem"
JIMM_SESSION_SECRET_KEY="$SESSION_SECRET"
JIMM_SESSION_COOKIE_MAX_AGE=86400
JIMM_SECURE_SESSION_COOKIES=true
JIMM_ACCESS_TOKEN_EXPIRY_DURATION=24h
JIMM_SSH_HOST_KEY="$SSH_KEY"
JIMM_SSH_PORT=18522
JIMM_SSH_MAX_CONCURRENT_CONNECTIONS=10
JIMM_OAUTH_ISSUER_URL=https://microjaas.test:18556/dex
JIMM_OAUTH_CLIENT_ID=microjaas
JIMM_OAUTH_CLIENT_SECRET="$OAUTH_SECRET"
JIMM_OAUTH_SCOPES='openid profile email offline_access'
JIMM_OAUTH_AUTH_STYLE=in_header
# Dex access tokens are opaque; local users do not supply group claims.
JIMM_OAUTH_GROUP_CLAIM_KEY=''
JIMM_IDP_GROUP_FETCHER_TYPE=''
JIMM_DASHBOARD_FINAL_REDIRECT_URL=https://microjaas.test:18600
JIMM_BOOTSTRAP_LOGIN_TOKEN_REFRESH_URL=https://microjaas.test:18443/.well-known/jwks.json
CORS_ALLOWED_ORIGINS='https://microjaas.test:18443 https://microjaas.test:18600'
OPENFGA_SCHEME=http
OPENFGA_HOST=127.0.0.1
OPENFGA_PORT=18580
OPENFGA_STORE="$STORE_ID"
OPENFGA_AUTH_MODEL="$MODEL_ID"
SSL_CERT_FILE="$SNAP_COMMON/ca.crt"
JIMM_LOG_LEVEL=info
